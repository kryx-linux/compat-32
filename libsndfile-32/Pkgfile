# Description: Library for manipulating sound files.
# URL: http://www.mega-nerd.com/libsndfile
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: alsa-lib-32 flac-32 libsndfile libvorbis-32

name=libsndfile-32
version=1.0.30
release=1
source=(https://github.com/erikd/libsndfile/releases/download/v$version/libsndfile-$version.tar.bz2)

build() {
	cd libsndfile-$version

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32

	make
	make DESTDIR=$PKG install
	
	rm -r $PKG/usr/{bin,include,share/man,share}
}
