# Description: xorg proto renderproto
# URL: http://xorg.freedesktop.org
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: xorg-renderproto

name=xorg-renderproto-32
version=0.11.1
release=1
source=(https://www.x.org/releases/individual/proto/renderproto-$version.tar.bz2)

build() {
	cd renderproto-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -rf $PKG/usr/{include,share}
}
