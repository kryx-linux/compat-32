# Description: X11 Direct Graphics Access extension library
# URL: http://xorg.freedesktop.org
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: xorg-libxext-32 xorg-libxxf86dga xorg-xf86dgaproto-32

name=xorg-libxxf86dga-32
version=1.1.4
release=1
source=(https://www.x.org/releases/individual/lib/libXxf86dga-$version.tar.bz2)

build() {
	cd libXxf86dga-$version

	./configure --prefix=/usr --mandir=/usr/man --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/{include,man}
}
