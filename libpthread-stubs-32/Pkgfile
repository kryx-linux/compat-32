name=libpthread-stubs-32
version=0.2
release=1
source=(http://xcb.freedesktop.org/dist/libpthread-stubs-$version.tar.bz2)

build() {
	cd libpthread-stubs-$version

	./configure --prefix=/usr --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install
}
