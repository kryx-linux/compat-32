# Description: Library of JPEG support functions.
# URL: https://www.libjpeg-turbo.org/
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: libjpeg-turbo

name=libjpeg-turbo-32
version=2.1.2
release=1
source=(https://downloads.sourceforge.net/project/${name%-*}/$version/${name%-*}-$version.tar.gz)

build() {
	prt-get isinst ninja && PKGMK_LIBJPEG_TURBO_32+=' -G Ninja'
	cmake -S ${name%-*}-$version -B build ${PKGMK_LIBJPEG_TURBO_32} \
		-G "Unix Makefiles" \
		-D CMAKE_INSTALL_PREFIX=/usr \
		-D CMAKE_INSTALL_LIBDIR=/usr/lib32 \
		-D CMAKE_BUILD_TYPE=Release \
		-D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
		-D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
		-D WITH_JPEG8=ON

	cmake --build build
	DESTDIR=$PKG cmake --install build

	rm -r $PKG/usr/{bin,include,share/man,share}
}
