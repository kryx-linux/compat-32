# Description: An essential exemplary set of plugins for gstreamer.
# URL: http://gstreamer.freedesktop.org/modules/gst-plugins-base.html
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: alsa-lib-32 cdparanoia-32 gst-plugins-base gstreamer-32 libtheora-32 libvisual-32 orc-32 pango-32 xorg-libxv-32

name=gst-plugins-base-32
version=1.6.3
release=1
source=(http://gstreamer.freedesktop.org/src/gst-plugins-base/gst-plugins-base-$version.tar.xz)

build() {
	cd gst-plugins-base-$version

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-debug \
		--disable-nls \
		--disable-dependency-tracking \
		--disable-valgrind \
		--disable-examples

	make
	make DESTDIR=$PKG install

	rm -rf $PKG/{etc,var} $PKG/usr/{bin,etc,include,sbin,share/man,share/gtk-doc,share}
}
