# Description: Widely used set of C/C++ libraries providing Unicode and Globalization support.
# URL: http://www.icu-project.org/
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: icu

name=icu-32
version=56.1
release=1
source=(http://download.icu-project.org/files/icu4c/$version/icu4c-${version//./_}-src.tgz)

build() {
	cd icu/source

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-samples \
		--disable-tests

	make
	make DESTDIR=$PKG install

	rm -r \
		$PKG/usr/bin \
		$PKG/usr/sbin \
		$PKG/usr/share/man \
		$PKG/usr/share/icu \
		$PKG/usr/include/layout \
		$PKG/usr/include/unicode
}
