# Description: a programming library for color text mode
# URL: https://gitlab.com/newt-ui/newt
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: libnewt popt-32 slang-32
# Optional: tcl-32

name=libnewt-32
version=0.52.25
release=1
source=(https://gitlab.com/newt-ui/newt/-/archive/$version/newt-$version.tar.bz2)

build() {
    cd newt-$version

    if prt-get isinst tcl-32; then
        sed -i "s:tcl8.4:tcl8.6:" Makefile.in
        echo '#define USE_INTERP_RESULT 1' >> config.h
    fi

    ./autogen.sh
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib32 \
        --without-python \
        --disable-nls \
        --without-tcl

    make
    make DESTDIR=$PKG install

    rm -r $PKG/usr/{bin,include,share}
}
