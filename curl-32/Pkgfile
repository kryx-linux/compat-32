# Description: A tool for transfering files with URL syntax
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# URL: https://curl.se/
# Depends on: curl openssl-32 zstd-32
# Optional: brotli-32

name=curl-32
version=8.11.0
release=1
source=(https://curl.se/download/${name%-*}-$version.tar.xz
  878bc429f26c27294787dc59d7b53345d9edc5aa.patch)

build() {
  cd ${name%-*}-$version

  prt-get isinst brotli && ! prt-get isinst brotli-32 && printf "\e[031mbrotli is detected on your system, please run:
  prt-get depinst brotli-32
  before continuing with curl-32.\033[0m\n" &&
  exit 1

  patch -Np1 -i $SRC/878bc429f26c27294787dc59d7b53345d9edc5aa.patch

  ./configure --prefix=/usr \
    --libdir=/usr/lib32 \
    --enable-ipv6 \
    --without-libidn2 \
    --with-openssl \
    --enable-threaded-resolver \
    --without-libpsl \
    --with-ca-bundle=/etc/ssl/cert.pem
  make
  make DESTDIR=$PKG install

  rm -r $PKG/usr/{bin,include,share/man,share}
}
