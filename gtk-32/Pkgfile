# Description: A multi-platform toolkit for creating graphical user interfaces
# URL: http://www.gtk.org/
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: atk-32 gdk-pixbuf-32 pango-32 xorg-libsm-32 xorg-libxcursor-32 xorg-libxinerama-32 xorg-libxrandr-32 xorg-libxcomposite-32 gtk

name=gtk-32
version=2.24.30
release=1
source=(http://download.gnome.org/sources/gtk+/${version%.*}/gtk+-$version.tar.xz
	CVE-2013-7447.patch)

build() {
	cd gtk+-$version

	patch -p1 -i $SRC/CVE-2013-7447.patch

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-cups

	make
	make DESTDIR=$PKG install

	mv $PKG/usr/bin/gtk-query-immodules-2.0 $PKG/usr/bin/gtk-query-immodules-2.0-32
	rm $PKG/usr/bin/{gtk-builder-convert,gtk-demo,gtk-update-icon-cache}
	rm -r $PKG/usr/etc $PKG/usr/{include,share}
}
