# Description: X font rendering client library
# URL: http://xorg.freedesktop.org
# Maintainer: Tilman Sauerbeck, tilman at crux dot nu
# Depends on: xorg-libxrender-32 freetype-32 fontconfig-32 xorg-libxft

name=xorg-libxft-32
version=2.3.1
release=1
source=(http://xorg.freedesktop.org/releases/individual/lib/libXft-$version.tar.bz2)

build() {
	cd libXft-$version

	./configure --prefix=/usr --mandir=/usr/man --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/{include,man}
}
