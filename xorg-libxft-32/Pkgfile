# Description: X font rendering client library
# URL: http://xorg.freedesktop.org
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: fontconfig-32 xorg-libxft xorg-libxrender-32

name=xorg-libxft-32
version=2.3.2
release=1
source=(http://xorg.freedesktop.org/releases/individual/lib/libXft-$version.tar.bz2)

build() {
	cd libXft-$version

	./configure --prefix=/usr --mandir=/usr/man --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -r $PKG/usr/{include,man}
}
