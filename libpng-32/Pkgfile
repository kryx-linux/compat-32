# Description: Library of PNG support functions
# URL: http://www.libpng.org/pub/png/libpng.html
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: libpng zlib-32

name=libpng-32
version=1.6.55
_base=${version:0:3}
_base=${_base/./}
release=1
source=(https://downloads.sourceforge.net/project/${name%-*}/${name%-*}$_base/$version/${name%-*}-$version.tar.xz
    libpng-1.6.54-apng.patch)

build() {
    patch -Np1 -d libpng-$version -i $SRC/libpng-1.6.54-apng.patch

    cmake -S libpng-$version -B build -G Ninja \
      -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_INSTALL_LIBDIR=lib32 \
      -D CMAKE_BUILD_TYPE=Release \
      -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
      -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
      -Wno-dev
    cmake --build build
    DESTDIR=$PKG cmake --install build

    rm -r $PKG/usr/{bin,include,share/man}
}
