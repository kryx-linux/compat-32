# Description:  Unicode annotation data library.
# URL: http://libuninameslist.sourceforge.net/
# Maintainer: Danny Rawlins, monster dot romster at gmail dot com
# Depends on: libuninameslist

name=libuninameslist-32
version=20091231
release=1
source=(http://downloads.sourceforge.net/project/libuninameslist/libuninameslist%20sources/Unicode_5.2-20091231/libuninameslist-$version.tar.bz2)

build() {
	cd libuninameslist

	./configure \
		--prefix=/usr \
		--libdir=/usr/lib32 \
		--disable-static

	make
	make DESTDIR=$PKG install
	rm -rf $PKG/usr/include
}
