# Description: A compressed GIF library compatible with libungif
# URL: https://giflib.sourceforge.net
# Maintainer: CRUX compat-32 Team, compat-32-ports at crux dot nu
# Depends on: giflib

name=giflib-32
version=6.1.2
release=1
source=(https://sourceforge.net/projects/giflib/files/giflib-$version.tar.gz)

build() {
  cd giflib-$version

  sed -i -e '/^install: all /s/ install-doc//' Makefile

  make
  make PREFIX=$PKG/usr LIBDIR=$PKG/usr/lib32 install

  rm -r $PKG/usr/{bin,share,include}
}
