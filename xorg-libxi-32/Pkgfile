# Description: X Input client library
# URL: http://xorg.freedesktop.org
# Maintainer: Tilman Sauerbeck, tilman at crux dot nu
# Depends on: xorg-xproto-32 xorg-libx11-32 xorg-xextproto-32 xorg-libxext-32 xorg-inputproto xorg-libxi

name=xorg-libxi-32
version=1.6.1
release=1
source=(http://xorg.freedesktop.org/releases/individual/lib/libXi-$version.tar.bz2)

build() {
	cd libXi-$version

	./configure --prefix=/usr --mandir=/usr/man --libdir=/usr/lib32

	make
	make DESTDIR=$PKG install

	rm -rf $PKG/usr/{include,man,share}
}
